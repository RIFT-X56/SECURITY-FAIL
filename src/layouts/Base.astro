---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/global.css';
import { SITE, NAV, FOOTER_NAV } from '../site';

interface Props {
  title?: string;
  description?: string;
  rain?: boolean;
}
const { title, description = SITE.description, rain = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · cybersécurité et pentesting`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

// CSP en balise meta : GitHub Pages ne permet pas d'en-têtes HTTP personnalisés.
// Aucun script ni style en ligne n'est utilisé, donc 'self' suffit partout.
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="theme-color" content="#05060d" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    {rain && <canvas id="rain" aria-hidden="true"></canvas>}
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${SITE.name}, accueil`}>
        <span class="brand-prompt">~/</span>XfivesiX<span class="brand-accent">_Security</span>
      </a>
      <nav aria-label="Navigation principale">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                ./{item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="contenu">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Liens secondaires">
        <ul>
          {FOOTER_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href={SITE.github} rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </nav>
      <p class="footer-note">
        Contenu à visée pédagogique et de sensibilisation. Aucun test n'est mené sans autorisation écrite.
      </p>
      <p class="footer-sign">{SITE.handle} · NeonHack // stay paranoid</p>
    </footer>
    {rain && <script is:inline src="/scripts/rain.js" defer></script>}
  </body>
</html>
